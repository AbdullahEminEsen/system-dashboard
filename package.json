{
  "name": "system-dashboard",
  "version": "1.2.3",
  "description": "Gerçek zamanlı sistem bilgilerini gösteren masaüstü widget",
  "author": {
    "name": "Abdullah Emin Esen",
    "email": "esenabdullahemin@gmail.com"
  },
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:native": "cd native && node-gyp rebuild",
    "lint": "eslint src --ext .js",
    "lint:fix": "eslint src --ext .js --fix"
  },
  "build": {
    "appId": "com.systemdashboard.app",
    "productName": "System Dashboard",
    "forceCodeSigning": false,
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "sign": null,
      "requestedExecutionLevel": "requireAdministrator"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "tar.gz"
      ],
      "category": "Utility"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "files": [
      "src/**/*",
      "package.json",
      "native/build/Release/sysmetrics.node"
    ],
    "asarUnpack": [
      "native/build/Release/sysmetrics.node"
    ],
    "asar": true
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "systeminformation": "^5.21.0"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^24.0.0",
    "eslint": "^8.57.0",
    "node-addon-api": "^8.9.2"
  }
}
